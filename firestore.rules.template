rules_version = '2';

// MODELLO delle regole Firestore di IsaBlock. Non si pubblica questo file:
// `node scripts/build-rules.mjs <dev|scuola>` genera firestore.rules (ignorato
// da git) sostituendo i segnaposto @@...@@. Vedi docs/CLOUD.md.
//
// Stato attuale: solo AUTENTICAZIONE e ruolo. Sketch, corsi e verifica non ci
// sono ancora, quindi tutto il resto è negato.
//
// Ruoli: "docente" = esiste docenti/{email}, documento creato SOLO da console
// (mai da client). Chiunque altro con un account ammesso è studente. Il ruolo
// non è memorizzato da nessuna parte: si ricalcola a ogni accesso.

service cloud.firestore {
  match /databases/{database}/documents {

    function dominioIstituzionale() {
      return '@@DOMINIO@@';
    }

    // @@EMAIL_PROVA@@ è una lista vuota nell'ambiente scuola; nell'ambiente dev
    // contiene le email di prova (il dominio non vale per l'account personale).
    function emailProva() {
      return @@EMAIL_PROVA@@;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Email verificata e (dominio istituzionale oppure email di prova).
    function isAmmesso() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower().matches('^[^@]+@' + dominioIstituzionale() + '$')
            || request.auth.token.email.lower() in emailProva());
    }

    function isDocente() {
      return isAmmesso()
        && exists(/databases/$(database)/documents/docenti/$(request.auth.token.email.lower()));
    }

    // Dominio e nome dell'istituto: servono alla pagina di accesso, senza login.
    match /config/istituto {
      allow read: if true;
      allow write: if false;
    }

    // Elenco docenti: ognuno può leggere soltanto il documento della propria
    // email (così l'app sa se è docente) e nessuno può elencare gli altri.
    // Scrittura solo da console.
    match /docenti/{email} {
      allow get: if isAmmesso() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Profilo: solo il proprio, con l'email del token. Il campo `ruolo` non è
    // scrivibile dal client in nessun caso (resta riservato alla console).
    match /utenti/{uid} {
      allow read: if isAmmesso() && request.auth.uid == uid;
      allow create, update: if isAmmesso()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'cognome'])
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow delete: if false;
    }
  }
}
