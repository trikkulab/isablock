rules_version = '2';

// MODELLO delle regole Firestore di IsaBlock. Non si pubblica questo file:
// `node scripts/build-rules.mjs <dev|scuola>` genera firestore.rules (ignorato
// da git) sostituendo i segnaposto @@...@@. Vedi docs/CLOUD.md.
//
// Stato attuale: AUTENTICAZIONE, ruolo, COMMENTI DEL DOCENTE sugli sketch condivisi,
// SKETCH PERSONALI (li scrive solo il
// proprietario; il docente di un corso legge solo quelli che l'autore ha
// condiviso con quel corso), CORSI e ISCRIZIONI (i docenti creano e gestiscono
// i corsi dall'app; lo studente si iscrive con il codice o lo aggiunge il
// docente), VERIFICHE, TRACCE, LAVORI e CONSEGNE.
//
// Ruoli: "docente" = esiste docenti/{email}, documento creato SOLO da console
// (mai da client). Chiunque altro con un account ammesso è studente. Il ruolo
// non è memorizzato da nessuna parte: si ricalcola a ogni accesso.

service cloud.firestore {
  match /databases/{database}/documents {

    // Limiti della modalità verifica: i valori stanno in src/cloud/verifica-config.js
    // (sezione `regole`) e li scrive scripts/build-rules.mjs. Non modificarli qui.
    function graziaSecondi() { return @@VERIFICA_graziaSecondi@@; }
    function maxTracce() { return @@VERIFICA_maxTracce@@; }
    function maxTitoloTraccia() { return @@VERIFICA_maxTitoloTraccia@@; }
    function maxTestoTraccia() { return @@VERIFICA_maxTestoTraccia@@; }
    function maxTitoloVerifica() { return @@VERIFICA_maxTitoloVerifica@@; }
    function maxVersioniConsegna() { return @@VERIFICA_maxVersioniConsegna@@; }
    function maxCampioni() { return @@VERIFICA_maxCampioni@@; }
    function maxProgramma() { return @@VERIFICA_maxProgramma@@; }
    function maxBlocchi() { return @@VERIFICA_maxBlocchi@@; }
    function maxMinutiExtra() { return @@VERIFICA_maxMinutiExtra@@; }
    function maxIstantanee() { return @@VERIFICA_maxIstantanee@@; }
    function maxIstantaneeSalto() { return @@VERIFICA_maxIstantaneeSalto@@; }

    function dominioIstituzionale() {
      return '@@DOMINIO@@';
    }

    // @@EMAIL_PROVA@@ è una lista vuota nell'ambiente scuola; nell'ambiente dev
    // contiene le email di prova (il dominio non vale per l'account personale).
    function emailProva() {
      return @@EMAIL_PROVA@@;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Email verificata e (dominio istituzionale oppure email di prova).
    function isAmmesso() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower().matches('^[^@]+@' + dominioIstituzionale() + '$')
            || request.auth.token.email.lower() in emailProva());
    }

    function isDocente() {
      return isAmmesso()
        && exists(/databases/$(database)/documents/docenti/$(request.auth.token.email.lower()));
    }

    // Dominio e nome dell'istituto: servono alla pagina di accesso, senza login.
    match /config/istituto {
      allow read: if true;
      allow write: if false;
    }

    // Elenco docenti: ognuno può leggere soltanto il documento della propria
    // email (così l'app sa se è docente) e nessuno può elencare gli altri.
    // Scrittura solo da console.
    match /docenti/{email} {
      allow get: if isAmmesso() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Profilo: solo il proprio, con l'email del token. Il campo `ruolo` non è
    // scrivibile dal client in nessun caso (resta riservato alla console).
    match /utenti/{uid} {
      allow read: if isAmmesso() && request.auth.uid == uid;
      allow create, update: if isAmmesso()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'cognome'])
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow delete: if false;
    }

    // Sketch personali. Un documento per sketch, con id `<uid>_<n>`, n da 0 a 49:
    // l'id deterministico è il TETTO di 50 sketch per persona, fatto rispettare
    // qui senza Cloud Functions (il client sceglie il primo numero libero).
    // `programma` è il JSON del file salvato, come TESTO (evita i limiti di
    // profondità dei documenti); tetto 200000 caratteri.
    // `creato` non cambia mai; `modificato` è sempre l'ora del server.
    // Una "creazione" su un id occupato è in realtà una modifica con `creato`
    // diverso: viene rifiutata, così due schede non si sovrascrivono.
    match /sketch/{id} {
      function idSketchDi(uid) {
        return id.matches('^' + uid + '_([0-9]|[1-4][0-9])$');
      }
      function emailMia() {
        return request.auth.token.email.lower();
      }
      // Condivisione con un corso: `condivisoCon` è il codice del corso (o null =
      // non condiviso). Si può impostare solo su un corso in cui si è iscritti, e
      // lo sketch porta allora email e nome dell'autore (servono al docente per
      // riconoscerlo e alla regola di lettura per controllare l'iscrizione).
      function iscrittoA(corsoId) {
        return exists(/databases/$(database)/documents/iscrizioni/$(corsoId + '_' + emailMia()));
      }
      function condivisioneValida(d) {
        let c = d.get('condivisoCon', null);
        return c == null
          || (c is string && c.matches('^[0-9A-HJKMNP-TV-Z]{4,12}$') && iscrittoA(c));
      }
      function sketchValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['proprietarioUid', 'nome', 'creato', 'modificato', 'programma',
                                 'condivisoCon', 'proprietarioEmail', 'proprietarioNome'])
          && d.keys().hasAll(['proprietarioUid', 'nome', 'creato', 'modificato', 'programma'])
          && d.proprietarioUid == request.auth.uid
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 60
          && d.programma is string && d.programma.size() > 0 && d.programma.size() <= 200000
          && d.creato is timestamp
          && d.modificato == request.time
          && d.get('proprietarioEmail', emailMia()) == emailMia()
          && d.get('proprietarioNome', 'x') is string
          && d.get('proprietarioNome', 'x').size() <= 80
          // condiviso => deve dichiarare chi è l'autore
          && (d.get('condivisoCon', null) == null
              || (d.get('proprietarioEmail', null) == emailMia()
                  && d.get('proprietarioNome', '').size() > 0));
      }
      function mioSketch() {
        return isAmmesso() && resource.data.proprietarioUid == request.auth.uid;
      }
      // Il docente del corso con cui lo sketch è condiviso lo LEGGE (mai lo scrive),
      // finché il corso è attivo e l'autore è ancora iscritto: se il docente lo
      // toglie da console, lo sketch sparisce dalla sua vista.
      function condivisoAlDocente() {
        return isDocente()
          && resource.data.get('condivisoCon', null) != null
          && emailMia() in get(/databases/$(database)/documents/corsi/$(resource.data.condivisoCon)).data.docenti
          && get(/databases/$(database)/documents/corsi/$(resource.data.condivisoCon)).data.get('attivo', true) == true
          && exists(/databases/$(database)/documents/iscrizioni/$(resource.data.condivisoCon + '_' + resource.data.get('proprietarioEmail', '')));
      }

      allow read: if mioSketch() || condivisoAlDocente();
      allow create: if isAmmesso()
        && idSketchDi(request.auth.uid)
        && sketchValido()
        && condivisioneValida(request.resource.data)
        && request.resource.data.creato == request.time;
      // La iscrizione si controlla solo se la condivisione CAMBIA: un autore tolto
      // dal corso deve poter ancora rinominare o aggiornare il proprio sketch.
      allow update: if mioSketch()
        && sketchValido()
        && request.resource.data.creato == resource.data.creato
        && (request.resource.data.get('condivisoCon', null) == resource.data.get('condivisoCon', null)
            || condivisioneValida(request.resource.data));
      allow delete: if mioSketch();
    }

    // Commenti del docente su uno sketch condiviso. Collezione SEPARATA: il docente
    // non scrive mai sullo sketch, e un commento non è parte del programma.
    // Id `<sketchId>_<n>`, n da 0 a 29: l'id deterministico è il TETTO di 30
    // commenti per sketch, imposto qui senza Cloud Functions.
    //   sketchId, sketchCreato (la `creato` dello sketch: gli id degli sketch si
    //   riusano, così un commento non passa a un altro sketch con lo stesso id),
    //   proprietarioUid (serve alla query «tutti i miei commenti»), corsoId (il corso
    //   in cui è stato scritto), bloccoId (id del blocco nel JSON, o null = sull'intero
    //   sketch), bloccoTesto (descrizione del blocco al momento del commento),
    //   testo (1-500), autoreEmail, autoreNome, creato, modificato, letto.
    // Scrive (crea) un docente del corso, solo su uno sketch condiviso con quel corso
    // il cui autore è iscritto. Modifica solo il testo dei propri; li cancella l'autore
    // o un altro docente del corso. Lo studente legge i commenti sui propri sketch e
    // cambia soltanto `letto`; li cancella solo se lo sketch non esiste più (o è stato
    // ricreato con lo stesso id).
    // Lettura del docente: query con `sketchId`, `corsoId` e `sketchCreato` fissati (le
    // regole possono usare solo i campi che la query fissa); le regole guardano
    // lo sketch com'è ORA: se lo studente lo condivide con un altro corso o smette,
    // i docenti del corso di prima non lo leggono più, e nemmeno i commenti.
    match /commenti/{id} {
      function datiSketch(sketchId) {
        return get(/databases/$(database)/documents/sketch/$(sketchId)).data;
      }
      function corsoDi(corsoId) {
        return get(/databases/$(database)/documents/corsi/$(corsoId)).data;
      }
      function emailCommento() {
        return request.auth.token.email.lower();
      }
      // Il docente che legge: docente del corso del commento (attivo), sketch ancora
      // condiviso con quel corso (stessa creazione) e autore ancora iscritto.
      function docenteVedeCommento() {
        let c = resource.data;
        let sk = datiSketch(c.sketchId);
        return isDocente()
          && emailCommento() in corsoDi(c.corsoId).docenti
          && corsoDi(c.corsoId).get('attivo', true) == true
          && sk.get('condivisoCon', null) == c.corsoId
          && sk.creato == c.sketchCreato
          && exists(/databases/$(database)/documents/iscrizioni/$(c.corsoId + '_' + sk.get('proprietarioEmail', '')));
      }
      // Forma del documento. Che sketchId e corsoId siano veri (e coerenti con il
      // proprietario) lo garantisce sketchCoerente(): i get() falliscono se non esistono.
      function commentoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sketchId', 'sketchCreato', 'proprietarioUid', 'corsoId', 'bloccoId',
                                 'bloccoTesto', 'testo', 'autoreEmail', 'autoreNome', 'creato', 'modificato', 'letto'])
          && d.keys().hasAll(['sketchId', 'sketchCreato', 'proprietarioUid', 'corsoId', 'bloccoId',
                              'bloccoTesto', 'testo', 'autoreEmail', 'autoreNome', 'creato', 'modificato', 'letto'])
          && d.sketchId is string
          && id.matches('^' + d.sketchId + '_([0-9]|[12][0-9])$')
          && d.sketchCreato is timestamp
          && d.proprietarioUid is string
          && d.corsoId is string
          && (d.bloccoId == null || (d.bloccoId is string && d.bloccoId.size() > 0 && d.bloccoId.size() <= 100))
          && d.bloccoTesto is string && d.bloccoTesto.size() <= 200
          && d.testo is string && d.testo.size() > 0 && d.testo.size() <= 500
          && d.autoreEmail == emailCommento()
          && d.autoreNome is string && d.autoreNome.size() > 0 && d.autoreNome.size() <= 80
          && d.creato == request.time
          && d.modificato == request.time
          && d.letto == false;
      }
      function sketchCoerente() {
        let d = request.resource.data;
        let sk = datiSketch(d.sketchId);
        return sk.proprietarioUid == d.proprietarioUid
          && sk.creato == d.sketchCreato
          && sk.get('condivisoCon', null) == d.corsoId
          && emailCommento() in corsoDi(d.corsoId).docenti
          && corsoDi(d.corsoId).get('attivo', true) == true
          && exists(/databases/$(database)/documents/iscrizioni/$(d.corsoId + '_' + sk.get('proprietarioEmail', '')));
      }

      allow read: if (isAmmesso() && resource.data.get('proprietarioUid', null) == request.auth.uid)
        || docenteVedeCommento();
      allow create: if isDocente() && commentoValido() && sketchCoerente();
      // Solo il testo, e solo l'autore (che deve poter ancora vedere il commento).
      allow update: if (isDocente()
            && resource.data.autoreEmail == emailCommento()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testo', 'modificato'])
            && request.resource.data.testo is string
            && request.resource.data.testo.size() > 0 && request.resource.data.testo.size() <= 500
            && request.resource.data.modificato == request.time
            && docenteVedeCommento())
        // lo studente: solo `letto`
        || (isAmmesso()
            && resource.data.proprietarioUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letto'])
            && request.resource.data.letto is bool);
      allow delete: if (isDocente() && resource.data.autoreEmail == emailCommento())
        || docenteVedeCommento()
        || (isAmmesso()
            && resource.data.proprietarioUid == request.auth.uid
            && (!exists(/databases/$(database)/documents/sketch/$(resource.data.sketchId))
                || datiSketch(resource.data.sketchId).creato != resource.data.sketchCreato));
    }

    // Verifiche (modalità verifica). Un documento per verifica, id automatico.
    //   corsoId, titolo, stato ('bozza' | 'aperta' | 'chiusa'), fine (fine prevista:
    //   obbligatoria per aprire; è il default delle scadenze personali), tracciaDefault
    //   (id di una traccia), creataDa, creato, apertaIl, chiusaIl (null finché non succede),
    //   archiviata (facoltativo: solo per le chiuse, nasconde la verifica dall'elenco del docente).
    // Niente scadenze personali né assegnazioni di tracce qui: stanno nel lavoro di ogni
    // studente, perché da tempo e traccia si dedurrebbe chi ha bisogni particolari.
    // Transizioni: bozza -> aperta -> chiusa -> aperta (la chiusa si può riaprire); in
    // bozza non si torna. Li scrive solo un docente del corso (ancora in `docenti`).
    // Gli studenti iscritti la leggono solo se NON è in bozza: la query è per corso
    // con `stato == 'aperta'` (o `in`), così la regola è dimostrabile dalla query.
    match /verifiche/{vid} {
      function emailVer() {
        return request.auth.token.email.lower();
      }
      function corsoVer(corsoId) {
        return get(/databases/$(database)/documents/corsi/$(corsoId)).data;
      }
      function docenteDelCorsoVer(corsoId) {
        return isDocente() && emailVer() in corsoVer(corsoId).docenti;
      }
      function iscrittoVer(corsoId) {
        return isAmmesso()
          && exists(/databases/$(database)/documents/iscrizioni/$(corsoId + '_' + emailVer()));
      }
      // Id di una traccia: t0 ... t(maxTracce-1), senza zeri iniziali. Il tetto sul numero
      // di tracce è imposto dall'id, come per sketch e commenti.
      function idTracciaValido(t) {
        return t is string && t.matches('^t(0|[1-9][0-9]*)$') && int(t[1:t.size()]) < maxTracce();
      }
      // Forma delle chiavi e dei campi liberi. Gli altri campi (creataDa, creato, apertaIl,
      // chiusaIl, stato, corsoId) sono fissati dai rami di create e update, che li confrontano
      // con valori precisi: un controllo di tipo in più sarebbe ridondante.
      function verificaValida(d) {
        return d.keys().hasOnly(['corsoId', 'titolo', 'stato', 'fine', 'tracciaDefault', 'creataDa',
                                 'creato', 'apertaIl', 'chiusaIl', 'archiviata'])
          && d.keys().hasAll(['corsoId', 'titolo', 'stato', 'fine', 'tracciaDefault', 'creataDa',
                              'creato', 'apertaIl', 'chiusaIl'])
          && d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= maxTitoloVerifica()
          && (d.fine == null || d.fine is timestamp)
          && (d.tracciaDefault == null || idTracciaValido(d.tracciaDefault))
          // `archiviata` è facoltativo (assente = false): riordino del docente, ammesso solo per le verifiche
          // CHIUSE. Una archiviata non si riapre finché non si ripristina (la riapertura la lascerebbe
          // archiviata e aperta: vietato da qui).
          && d.get('archiviata', false) is bool
          && (d.get('archiviata', false) == false || d.stato == 'chiusa');
      }
      function cambiate() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read: if docenteDelCorsoVer(resource.data.corsoId)
        || (resource.data.stato != 'bozza' && iscrittoVer(resource.data.corsoId));
      allow create: if verificaValida(request.resource.data)
        && docenteDelCorsoVer(request.resource.data.corsoId)
        && corsoVer(request.resource.data.corsoId).get('attivo', true) == true
        && request.resource.data.stato == 'bozza'
        && request.resource.data.creataDa == emailVer()
        && request.resource.data.creato == request.time
        && request.resource.data.apertaIl == null
        && request.resource.data.chiusaIl == null;
      allow update: if docenteDelCorsoVer(resource.data.corsoId)
        && verificaValida(request.resource.data)
        && request.resource.data.corsoId == resource.data.corsoId
        && request.resource.data.creataDa == resource.data.creataDa
        && request.resource.data.creato == resource.data.creato
        && (
          // bozza: titolo, fine e traccia di default si cambiano liberamente
          (resource.data.stato == 'bozza' && request.resource.data.stato == 'bozza'
            && request.resource.data.apertaIl == null && request.resource.data.chiusaIl == null)
          // apertura: serve una fine nel futuro e una traccia di default che esista
          || (resource.data.stato == 'bozza' && request.resource.data.stato == 'aperta'
              && cambiate().hasOnly(['stato', 'apertaIl', 'fine', 'tracciaDefault', 'titolo'])
              && request.resource.data.apertaIl == request.time
              && request.resource.data.fine is timestamp && request.resource.data.fine > request.time
              && exists(/databases/$(database)/documents/verifiche/$(vid)/tracce/$(request.resource.data.tracciaDefault)))
          // aperta: si cambia titolo e fine (se cambia, nel futuro)
          || (resource.data.stato == 'aperta' && cambiate().hasOnly(['titolo', 'fine'])
              && (request.resource.data.fine == resource.data.fine || request.resource.data.fine > request.time))
          // chiusura
          || (resource.data.stato == 'aperta' && request.resource.data.stato == 'chiusa'
              && cambiate().hasOnly(['stato', 'chiusaIl'])
              && request.resource.data.chiusaIl == request.time)
          // chiusa: il titolo, e archiviare o ripristinare
          || (resource.data.stato == 'chiusa' && cambiate().hasOnly(['titolo', 'archiviata']))
          // riapertura: la fine può restare nel passato (si riapre per dare tempo a qualcuno)
          || (resource.data.stato == 'chiusa' && request.resource.data.stato == 'aperta'
              && cambiate().hasOnly(['stato', 'apertaIl', 'fine'])
              && request.resource.data.apertaIl == request.time
              && request.resource.data.fine is timestamp)
        );
      // Si butta via solo una bozza (prima il client cancella le sue tracce).
      allow delete: if docenteDelCorsoVer(resource.data.corsoId) && resource.data.stato == 'bozza';

      // Tracce: id `t<n>`, n da 0 a maxTracce-1. titolo NEUTRO scelto dal docente, testoMd
      // (Markdown), rev (0 alla creazione, +1 a ogni modifica: lo studente si accorge
      // dell'aggiornamento), modificato. Scrive solo il docente del corso: in bozza e a
      // verifica aperta (un refuso si corregge), mai a chiusa; si cancella solo in bozza.
      // Lo studente legge SOLO la traccia che gli è stata assegnata nel suo lavoro, e mai
      // prima dell'apertura (verifica in bozza).
      match /tracce/{tid} {
        function verificaTr() {
          return get(/databases/$(database)/documents/verifiche/$(vid)).data;
        }
        function tracciaValida(d) {
          return d.keys().hasOnly(['titolo', 'testoMd', 'rev', 'modificato'])
            && d.keys().hasAll(['titolo', 'testoMd', 'rev', 'modificato'])
            && d.titolo is string && d.titolo.size() > 0 && d.titolo.size() <= maxTitoloTraccia()
            && d.testoMd is string && d.testoMd.size() > 0 && d.testoMd.size() <= maxTestoTraccia()
            && d.modificato == request.time;
        }
        allow read: if docenteDelCorsoVer(verificaTr().corsoId)
          || (isAmmesso()
              && verificaTr().stato != 'bozza'
              && get(/databases/$(database)/documents/verifiche/$(vid)/lavori/$(emailVer())).data.get('tracciaId', null) == tid);
        allow create: if idTracciaValido(tid)
          && docenteDelCorsoVer(verificaTr().corsoId)
          && verificaTr().stato in ['bozza', 'aperta']
          && tracciaValida(request.resource.data)
          && request.resource.data.rev == 0;
        allow update: if docenteDelCorsoVer(verificaTr().corsoId)
          && verificaTr().stato in ['bozza', 'aperta']
          && tracciaValida(request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1;
        allow delete: if docenteDelCorsoVer(verificaTr().corsoId) && verificaTr().stato == 'bozza';
      }

      // Lavori: il documento PERSONALE di ogni studente in una verifica, id = email minuscola
      // (il docente lo crea prima del login dello studente, e dell'uid non sa niente).
      //   Del docente:  tracciaId (la traccia assegnata), scadenza (timestamp assoluto: fine
      //                 prevista o tempo aggiuntivo; nessun motivo scritto, mai).
      //   Dello studente: studenteNome, programma (testo JSON) + programmaHash, nBlocchi,
      //                 esecuzioni {n, esito, quando}, campioni (ultimi N di {t, n}), entrato
      //                 (ora del primo salvataggio), ultimoSegnale (ora del server a ogni
      //                 scrittura: serve anche da battito), tracciaRevVista, consegnato.
      // Traccia e scadenza stanno QUI, non nella verifica, perché la verifica la legge ogni
      // studente iscritto: da tempo e traccia si dedurrebbe chi ha bisogni particolari.
      // Il docente crea il documento (in bozza o a verifica aperta) e può cambiare scadenza
      // sempre, traccia solo finché lo studente non è entrato. In bozza la traccia può essere
      // vuota («di tutti»), da aperta mai. Lo studente scrive solo i suoi
      // campi, a verifica aperta, entro la scadenza personale più la grazia, e finché non ha
      // consegnato; `consegnato: true` solo insieme alla consegna (batch atomico, existsAfter).
      match /lavori/{lid} {
        function verificaLav() {
          return get(/databases/$(database)/documents/verifiche/$(vid)).data;
        }
        function docenteLav() {
          return docenteDelCorsoVer(verificaLav().corsoId);
        }
        function mioLavoro() {
          return isAmmesso() && emailVer() == lid;
        }
        // `$(t)` è sempre UN segmento di percorso: una traccia come 't0/sub/x' non punta altrove.
        function tracciaEsiste(t) {
          return exists(/databases/$(database)/documents/verifiche/$(vid)/tracce/$(t));
        }
        // `tracciaId` vuoto (null) = «traccia di tutti»: ammesso SOLO in bozza, dove segue la traccia
        // predefinita qualunque sia; all'apertura il client lo sostituisce con l'id vero nello stesso
        // batch. Da aperta in poi la traccia è sempre esplicita.
        function tracciaOk(t) {
          return (t == null && verificaLav().stato == 'bozza')
            || (verificaLav().stato != 'chiusa' && tracciaEsiste(t));
        }
        // Il tempo in più dato a mano (facoltativo: assente = 0). La scadenza è la fine più questo.
        function extraValido(d) {
          return d.get('minutiExtra', 0) is int && d.get('minutiExtra', 0) >= 0
            && d.get('minutiExtra', 0) <= maxMinutiExtra();
        }
        function lavoroNuovoValido(d) {
          return d.keys().hasOnly(['studenteEmail', 'tracciaId', 'scadenza', 'minutiExtra', 'entrato', 'consegnato'])
            && extraValido(d)
            && d.keys().hasAll(['studenteEmail', 'tracciaId', 'scadenza', 'entrato', 'consegnato'])
            && d.studenteEmail == lid
            && tracciaOk(d.tracciaId)
            && d.scadenza is timestamp
            && d.entrato == null
            && d.consegnato == false;
        }
        function aggiornamentoDocente() {
          let cambiate = request.resource.data.diff(resource.data).affectedKeys();
          return docenteLav()
            && cambiate.hasOnly(['scadenza', 'minutiExtra', 'tracciaId', 'consegnato', 'osservato'])
            && extraValido(request.resource.data)
            // Vista dal vivo: il segno «lo sto guardando» è l'ora del server, solo a verifica aperta e per chi è già entrato.
            && (!cambiate.hasAny(['osservato'])
                || (request.resource.data.osservato == request.time
                    && verificaLav().stato == 'aperta'
                    && resource.data.entrato != null))
            && request.resource.data.scadenza is timestamp
            && (request.resource.data.tracciaId == resource.data.tracciaId
                || (resource.data.entrato == null
                    && tracciaOk(request.resource.data.tracciaId)))
            // Sblocco per la riconsegna: `consegnato` torna falso SOLO riaprendo la verifica, cioè nello
            // stesso batch che la porta da chiusa ad aperta.
            && (!cambiate.hasAny(['consegnato'])
                || (resource.data.consegnato == true && request.resource.data.consegnato == false
                    && verificaLav().stato == 'chiusa'
                    && getAfter(/databases/$(database)/documents/verifiche/$(vid)).data.stato == 'aperta'));
        }
        function esecuzioniValide(e) {
          return e.keys().hasOnly(['n', 'esito', 'quando'])
            && e.n is int && e.n >= 0 && e.n <= 100000
            && e.esito in ['mai', 'ok', 'errore']
            && (e.quando == null || e.quando is int);
        }
        function aggiornamentoStudente() {
          let d = request.resource.data;
          return mioLavoro()
            && verificaLav().stato == 'aperta'
            // una traccia ancora «di tutti» (vuota) non è risolta: meglio che la scrittura fallisca
            // in modo visibile che far lavorare lo studente senza traccia
            && resource.data.tracciaId != null
            && request.time <= resource.data.scadenza + duration.value(graziaSecondi(), 's')
            && resource.data.consegnato == false
            && d.diff(resource.data).affectedKeys().hasOnly(['studenteNome', 'programma', 'programmaHash',
                 'nBlocchi', 'esecuzioni', 'campioni', 'entrato', 'consegnato', 'ultimaConsegna', 'ultimoSegnale', 'tracciaRevVista'])
            // ogni scrittura è un segnale di vita, e il primo salvataggio è l'ingresso
            && d.ultimoSegnale == request.time
            && ((resource.data.entrato == null && d.entrato == request.time)
                || (resource.data.entrato != null && d.entrato == resource.data.entrato))
            && d.get('studenteNome', '').size() > 0 && d.get('studenteNome', '').size() <= 80
            && d.get('programma', 'x') is string
            && d.get('programma', 'x').size() > 0 && d.get('programma', 'x').size() <= maxProgramma()
            && d.get('programmaHash', 'x') is string && d.get('programmaHash', 'x').size() <= 16
            && d.get('nBlocchi', 0) is int && d.get('nBlocchi', 0) >= 0 && d.get('nBlocchi', 0) <= maxBlocchi()
            && esecuzioniValide(d.get('esecuzioni', {'n': 0, 'esito': 'mai', 'quando': null}))
            && d.get('campioni', []) is list && d.get('campioni', []).size() <= maxCampioni()
            && d.get('tracciaRevVista', 0) is int && d.get('tracciaRevVista', 0) >= 0
            // `ultimaConsegna` = versione della consegna che questo batch crea. Senza consegnare non si tocca;
            // consegnando deve esserci una consegna NUOVA con quel numero (create-only: non esisteva prima).
            && ((d.consegnato == false
                 && d.get('ultimaConsegna', 0) == resource.data.get('ultimaConsegna', 0))
                || (d.get('ultimaConsegna', 0) is int
                    && d.get('ultimaConsegna', 0) >= 1 && d.get('ultimaConsegna', 0) <= maxVersioniConsegna()
                    && existsAfter(/databases/$(database)/documents/verifiche/$(vid)/consegne/$(lid + '_' + string(d.get('ultimaConsegna', 0))))
                    && !exists(/databases/$(database)/documents/verifiche/$(vid)/consegne/$(lid + '_' + string(d.get('ultimaConsegna', 0))))));
        }

        allow read: if docenteLav() || (mioLavoro() && verificaLav().stato != 'bozza');
        allow create: if docenteLav()
          && verificaLav().stato in ['bozza', 'aperta']
          && exists(/databases/$(database)/documents/iscrizioni/$(verificaLav().corsoId + '_' + lid))
          && lavoroNuovoValido(request.resource.data);
        allow update: if aggiornamentoDocente() || aggiornamentoStudente();
        allow delete: if docenteLav() && resource.data.entrato == null;

        // Storia del lavoro: istantanee del programma per capire come evolve (non è un registro di ogni modifica).
        // Id a ANELLO: `p<k>` periodiche (k < maxIstantanee), `a<k>`/`d<k>` coppia prima/dopo un salto di blocchi
        // (k < maxIstantaneeSalto): la nuova prende il posto della più vecchia, quindi i dati non crescono. Le scrive
        // solo lo studente, a verifica aperta, entro la scadenza personale più la grazia, finché non ha consegnato; le
        // legge solo il docente del corso. Mai cancellate da qui (le toglie la pulizia di fine anno).
        match /storia/{sid} {
          function lavoroSt() {
            return get(/databases/$(database)/documents/verifiche/$(vid)/lavori/$(lid)).data;
          }
          function indiceOk(limite) {
            return sid.matches('[pad][0-9]{1,2}') && string(int(sid[1:])) == sid[1:] && int(sid[1:]) < limite;
          }
          function istantaneaValida(d) {
            return d.keys().hasOnly(['programma', 'nBlocchi', 't', 'tipo'])
              && d.keys().hasAll(['programma', 'nBlocchi', 't', 'tipo'])
              && d.programma is string && d.programma.size() > 0 && d.programma.size() <= maxProgramma()
              && d.nBlocchi is int && d.nBlocchi >= 0 && d.nBlocchi <= maxBlocchi()
              && d.t == request.time
              && ((d.tipo == 'periodica' && sid[0:1] == 'p' && indiceOk(maxIstantanee()))
                  || (d.tipo == 'prima' && sid[0:1] == 'a' && indiceOk(maxIstantaneeSalto()))
                  || (d.tipo == 'dopo' && sid[0:1] == 'd' && indiceOk(maxIstantaneeSalto())));
          }
          allow read: if docenteLav();
          allow create, update: if mioLavoro()
            && verificaLav().stato == 'aperta'
            && lavoroSt().entrato != null
            && lavoroSt().consegnato == false
            && request.time <= lavoroSt().scadenza + duration.value(graziaSecondi(), 's')
            && istantaneaValida(request.resource.data);
          allow delete: if false;
        }
      }

      // Consegne: la copia IMMUTABILE del lavoro. Id `<email>_<n>`, n da 1 a maxVersioniConsegna
      // (la versione valida è l'ultima). Si creano e basta: update e delete sono sempre negati.
      //   studenteEmail, studenteNome, corsoId, titolo (della verifica: servono all'elenco dello
      //   studente), versione, origine, tracciaId, programma, creato (= request.time).
      // Quattro origini:
      //   studente / automatica: scritta dallo studente a verifica aperta, entro la scadenza
      //     personale più la grazia, in un BATCH con l'update del suo lavoro (consegnato: true). Il
      //     contenuto è quello del lavoro DOPO il batch (getAfter), la traccia quella assegnata.
      //     Le due regole (lavoro e consegna) si richiamano a vicenda: né l'una né l'altra da sole.
      //   raccolta: la crea un docente del corso a verifica CHIUSA, dal lavoro com'è (contenuto
      //     identico). Una v>1 vuole la precedente. Chi non è mai entrato non ha niente da raccogliere.
      //   file: la crea un docente a verifica chiusa caricando il file di emergenza dello studente
      //     (docenteEmail, impronta, offlineDa, nBlocchiSincronizzati, nomeFile). L'impronta non la
      //     verificano le regole, ma il client all'importazione.
      // Riconsegna: riaprendo la verifica il docente sblocca i lavori consegnati (`consegnato` torna
      // falso, nello stesso batch della riapertura) e lo studente può consegnare di nuovo: v2, v3...
      // Il numero è `ultimaConsegna` del suo lavoro, e deve seguire l'ultima consegna esistente.
      match /consegne/{cid} {
        function verificaCon() {
          return get(/databases/$(database)/documents/verifiche/$(vid)).data;
        }
        function lavoroPrima(email) {
          return get(/databases/$(database)/documents/verifiche/$(vid)/lavori/$(email)).data;
        }
        function lavoroDopo(email) {
          return getAfter(/databases/$(database)/documents/verifiche/$(vid)/lavori/$(email)).data;
        }
        function campiBase() {
          return ['studenteEmail', 'studenteNome', 'corsoId', 'titolo', 'versione', 'origine', 'tracciaId',
                  'programma', 'creato'];
        }
        function campiFile() {
          return ['studenteEmail', 'studenteNome', 'corsoId', 'titolo', 'versione', 'origine', 'tracciaId',
                  'programma', 'creato', 'docenteEmail', 'impronta', 'offlineDa', 'nBlocchiSincronizzati', 'nomeFile'];
        }
        // Valido per ogni origine: id coerente col contenuto, versione ammessa e consecutiva,
        // intestazione uguale a quella della verifica.
        function consegnaValida(d) {
          // `is int` protegge da un decimale (1.0) arrivato da un'API diretta: l'SDK invia sempre interi
          return d.versione is int && d.versione <= maxVersioniConsegna()
            && cid == d.studenteEmail + '_' + string(d.versione)
            && (d.versione == 1
                || exists(/databases/$(database)/documents/verifiche/$(vid)/consegne/$(d.studenteEmail + '_' + string(d.versione - 1))))
            && d.creato == request.time
            && d.corsoId == verificaCon().corsoId
            && d.titolo == verificaCon().titolo
            && d.programma.size() > 0 && d.programma.size() <= maxProgramma();
        }
        function consegnaDelloStudente() {
          let d = request.resource.data;
          return isAmmesso()
            && d.keys().hasOnly(campiBase()) && d.keys().hasAll(campiBase())
            && d.origine in ['studente', 'automatica']
            && d.versione == lavoroDopo(d.studenteEmail).get('ultimaConsegna', 0)
            && d.studenteEmail == emailVer()
            // Lo stato `aperta` e la scadenza (con la grazia) li impone l'update del lavoro, che deve
            // stare nello stesso batch: qui non si ripetono (due copie dello stesso conto divergerebbero).
            // Identità (isAmmesso, studenteEmail) e forma, invece, restano scritte anche qui.
            && lavoroPrima(d.studenteEmail).consegnato == false
            && lavoroDopo(d.studenteEmail).consegnato == true
            && d.programma == lavoroDopo(d.studenteEmail).programma
            && d.studenteNome == lavoroDopo(d.studenteEmail).studenteNome
            && d.tracciaId == lavoroPrima(d.studenteEmail).tracciaId
            && consegnaValida(d);
        }
        function consegnaDelDocente() {
          let d = request.resource.data;
          return docenteDelCorsoVer(verificaCon().corsoId)
            && verificaCon().stato == 'chiusa'
            && d.docenteEmail == emailVer()
            && d.tracciaId == lavoroPrima(d.studenteEmail).tracciaId
            && consegnaValida(d)
            && ((d.origine == 'raccolta'
                 && d.keys().hasOnly(campiBase().concat(['docenteEmail']))
                 && d.keys().hasAll(campiBase().concat(['docenteEmail']))
                 && d.programma == lavoroPrima(d.studenteEmail).programma
                 && d.studenteNome == lavoroPrima(d.studenteEmail).studenteNome)
                || (d.origine == 'file'
                    && d.keys().hasOnly(campiFile()) && d.keys().hasAll(campiFile())
                    && d.studenteNome.size() > 0 && d.studenteNome.size() <= 80
                    && d.impronta.size() > 0 && d.impronta.size() <= 64
                    && d.nomeFile.size() > 0 && d.nomeFile.size() <= 120
                    && (d.offlineDa == null || (d.offlineDa is string && d.offlineDa.size() <= 40))
                    && (d.nBlocchiSincronizzati == null
                        || (d.nBlocchiSincronizzati is int && d.nBlocchiSincronizzati >= 0 && d.nBlocchiSincronizzati <= maxBlocchi()))));
        }

        allow read: if (isAmmesso() && resource.data.studenteEmail == emailVer())
          || docenteDelCorsoVer(verificaCon().corsoId);
        allow create: if consegnaDelloStudente() || consegnaDelDocente();
        allow update, delete: if false;
      }
    }

    // Corsi. Un documento per corso, con id = CODICE di accesso (6 caratteri
    // Crockford, come in isaquiz).
    //   materia, classe (testo libero, es. "3AINF"), annoScolastico ("2026/27"),
    //   docenti (elenco di email minuscole: il primo è il TITOLARE, gli altri
    //   codocenti), iscrizioniAperte (bool), attivo (bool, false = archiviato),
    //   nome (facoltativo), creato (ora del server, solo nei corsi creati dall'app).
    // Lettura: i docenti del corso e i suoi iscritti. L'elenco dei propri corsi da
    // docente si ottiene con una query `docenti array-contains <mia email>`.
    // Scrittura: ogni docente (esiste docenti/{email}) crea i corsi che vuole; li
    // modificano i docenti del corso. Non si cancellano: si archiviano.
    match /corsi/{codice} {
      function codiceValido(c) {
        return c.matches('^[0-9A-HJKMNP-TV-Z]{4,12}$');
      }
      // Nell'elenco del corso E ancora docente: se lo si toglie da `docenti` (console)
      // perde subito anche la lettura, senza aspettare che lo si tolga dall'array.
      function docenteDelCorso() {
        return isDocente() && request.auth.token.email.lower() in resource.data.docenti;
      }
      function iscrittoAlCorso() {
        return isAmmesso()
          && exists(/databases/$(database)/documents/iscrizioni/$(codice + '_' + request.auth.token.email.lower()));
      }
      // Forma del corso risultante (vale per creazione e modifica).
      function corsoValido(d) {
        return d.keys().hasOnly(['materia', 'classe', 'annoScolastico', 'nome', 'docenti',
                                 'iscrizioniAperte', 'attivo', 'creato'])
          && d.keys().hasAll(['materia', 'classe', 'annoScolastico', 'docenti', 'iscrizioniAperte', 'attivo'])
          && d.materia is string && d.materia.size() > 0 && d.materia.size() <= 60
          && d.classe is string && d.classe.size() > 0 && d.classe.size() <= 20
          && d.annoScolastico is string && d.annoScolastico.matches('^[0-9]{4}/[0-9]{2}$')
          && d.get('nome', '') is string && d.get('nome', '').size() <= 60
          && d.docenti is list && d.docenti.size() >= 1
          && d.docenti.toSet().size() == d.docenti.size()
          && d.iscrizioniAperte is bool
          && d.attivo is bool;
      }
      // Il titolare è docenti[0] e non cambia mai. Un solo cambio per volta: si
      // aggiunge UN codocente in coda (deve esistere in `docenti`: altrimenti uno
      // studente potrebbe farsi dare accesso agli sketch condivisi) oppure se ne
      // toglie uno qualsiasi tranne il titolare. Le regole non hanno cicli, per
      // questo non si accetta più di un cambio alla volta.
      function docentiOk(vecchi, nuovi) {
        return nuovi[0] == vecchi[0]
          && (nuovi == vecchi
              || (nuovi.size() == vecchi.size() + 1
                  && nuovi[0:vecchi.size()] == vecchi
                  && nuovi[vecchi.size()].matches('^[^/]+$')
                  && nuovi[vecchi.size()] == nuovi[vecchi.size()].lower()
                  && exists(/databases/$(database)/documents/docenti/$(nuovi[vecchi.size()])))
              || (nuovi.size() == vecchi.size() - 1 && vecchi.hasAll(nuovi)));
      }
      allow get: if docenteDelCorso() || iscrittoAlCorso();
      allow list: if docenteDelCorso();
      allow create: if isDocente()
        && codiceValido(codice)
        && corsoValido(request.resource.data)
        && request.resource.data.keys().hasAll(['creato'])
        && request.resource.data.creato == request.time
        && request.resource.data.docenti == [request.auth.token.email.lower()]
        && request.resource.data.attivo == true;
      // `creato` non cambia: così scrivere su un codice già occupato (una "creazione"
      // che in realtà è una modifica) viene rifiutato.
      allow update: if docenteDelCorso()
        && corsoValido(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['materia', 'classe', 'annoScolastico', 'nome', 'docenti', 'iscrizioniAperte', 'attivo'])
        && docentiOk(resource.data.docenti, request.resource.data.docenti);
      allow delete: if false;
    }

    // Iscrizioni: id `<CODICE>_<email minuscola>`. Con l'email nell'id il docente
    // può iscrivere anche chi non ha mai fatto login.
    // Due modi di crearle, con lo stesso documento (corsoId, email, creato):
    //  - auto-iscrizione: lo studente digita il codice; riesce solo se il corso
    //    esiste (il codice è l'id), è attivo e ha le iscrizioni aperte. Chi è docente
    //    (esiste docenti/{email}) non si iscrive mai come studente;
    //  - dal docente del corso: aggiunge uno studente per email (dominio
    //    istituzionale, minuscola, non docente), anche a iscrizioni chiuse ma non a
    //    corso archiviato.
    // Il client non modifica iscrizioni. Le cancella solo un docente del corso: lo
    // studente non esce da solo.
    match /iscrizioni/{id} {
      // L'id finisce sempre con `_<email>`: si decide da lì, così anche leggere una
      // iscrizione che non esiste (per sapere se si è già iscritti) è permesso.
      function idMio() {
        let e = request.auth.token.email.lower();
        return id.size() > e.size() + 1
          && id[id.size() - e.size() - 1:id.size() - e.size()] == '_'
          && id[id.size() - e.size():] == e;
      }
      function corsoDi(corsoId) {
        return get(/databases/$(database)/documents/corsi/$(corsoId)).data;
      }
      // Email di uno studente aggiunto da un docente: minuscola, senza '/', del
      // dominio istituzionale (o email di prova), e mai quella di un docente.
      function emailStudenteValida(e) {
        return e is string && e.size() <= 100 && e == e.lower()
          && (e.matches('^[^@/ ]+@' + dominioIstituzionale() + '$') || e in emailProva())
          && !exists(/databases/$(database)/documents/docenti/$(e));
      }
      function formaIscrizione() {
        let d = request.resource.data;
        return d.keys().hasOnly(['corsoId', 'email', 'creato'])
          && d.keys().hasAll(['corsoId', 'email', 'creato'])
          && d.corsoId is string
          && d.corsoId.matches('^[0-9A-HJKMNP-TV-Z]{4,12}$')
          && d.email is string
          && id == d.corsoId + '_' + d.email
          && d.creato == request.time;
      }
      allow get: if isAmmesso() && idMio();
      // L'elenco degli iscritti di un corso lo leggono i suoi docenti (query con
      // `corsoId == <codice>`): serve a sapere chi si è iscritto e, di lì, a chiedere
      // gli sketch che ognuno ha condiviso.
      allow list: if isAmmesso()
        && (resource.data.email == request.auth.token.email.lower()
            || (isDocente() && request.auth.token.email.lower() in get(/databases/$(database)/documents/corsi/$(resource.data.corsoId)).data.docenti));
      allow create: if isAmmesso()
        && formaIscrizione()
        && ((request.resource.data.email == request.auth.token.email.lower()
             && !exists(/databases/$(database)/documents/docenti/$(request.auth.token.email.lower()))
             && corsoDi(request.resource.data.corsoId).get('iscrizioniAperte', false) == true
             && corsoDi(request.resource.data.corsoId).get('attivo', true) == true)
            || (isDocente()
                && emailStudenteValida(request.resource.data.email)
                && request.auth.token.email.lower() in corsoDi(request.resource.data.corsoId).docenti
                && corsoDi(request.resource.data.corsoId).get('attivo', true) == true));
      allow update: if false;
      // Il corso si ricava dall'id (il codice non contiene '_'), non dal contenuto.
      allow delete: if isDocente()
        && request.auth.token.email.lower() in corsoDi(id.split('_')[0]).docenti;
    }
  }
}
